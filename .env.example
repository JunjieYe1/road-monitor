# 复制为 .env.development 后按本地环境修改
# 开发环境通过 Vite 代理访问智能体后端，避免浏览器 CORS
VITE_AGENT_BASE_URL=/agent
VITE_AGENT_PROXY_TARGET=http://127.0.0.1:8000
# 生产构建时填写（build 时注入）：VITE_AGENT_BASE_URL=http://<后端公网或内网可访问的 API 根地址>
# 若站点为 HTTPS 而 API 仅 HTTP，浏览器会拦 Mixed Content，需为 API 配 HTTPS 反代

# 地图病害点：设为 false 时使用仅内置 12 条 mock，不从 /data/recheck-alerts.json 加载
# VITE_USE_RECHECK_ALERTS=false
# 可选：覆盖静态 JSON URL（默认 /data/recheck-alerts.json）
# VITE_RECHECK_ALERTS_JSON=/data/recheck-alerts.json

# 为 true 时优先 POST /query/select 加载地图点位（需已登录，Bearer 走 agent）；失败则回退 JSON 或内联 mock
# VITE_USE_QUERY_SELECT_ALERTS=true
# 可选：筛选条件（逗号分隔，与 query(3).md 一致）；全部省略则请求体几乎为空（后端可能返回全表，数据量大）
# VITE_QUERY_SELECT_YEARS=2022,2024
# VITE_QUERY_SELECT_REGIONS=上城区
# VITE_QUERY_SELECT_ROAD_NAMES=
# VITE_QUERY_SELECT_DISEASE_TYPES=
